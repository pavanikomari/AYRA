# ==============================================================================
# AYRA – Environment Configuration Template
# Duplicate this file to .env or .env.local and populate with your own project keys.
# DO NOT commit real secrets or service_role keys to source control!
# ==============================================================================

# Supabase Project URL (Base URL, no trailing path)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Client Anon / Publishable Key (Safe for frontend use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

